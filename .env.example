# ---------------------------------------------------------------------------
# Ejentic AI - environment configuration
# Copy to .env.local for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# ---- Datastore -------------------------------------------------------------
# When set, the app uses PostgreSQL through Prisma.
# When unset, it falls back to a local JSON file at .data/scraper.json
# (development only - not safe for concurrent writes or multi-process use).
DATABASE_URL=postgresql://ejentic:<PASSWORD>@localhost:5432/ejentic?schema=public

# Password used by docker-compose.yml to bootstrap the local Postgres container.
# Local infrastructure only; never reuse this default anywhere real.
POSTGRES_PASSWORD=change-me-local-only

# ---- Queue -----------------------------------------------------------------
# When set, crawl tasks are distributed through Redis with BullMQ.
# When unset, the worker uses a durable file-backed queue under .data/queue.
REDIS_URL=redis://localhost:6379

# ---- Worker ----------------------------------------------------------------
# How often the worker polls for new queue items when idle (milliseconds).
SCRAPER_POLL_MS=1000
# Upper bound on URLs processed concurrently per job.
SCRAPER_WORKER_CONCURRENCY=5
# Optional stable identity for a worker process (defaults to host + pid).
# SCRAPER_WORKER_ID=worker-1
# SCRAPER_WORKER_NAME=primary

# ---- Authentication --------------------------------------------------------
# REQUIRED in production. Signs session cookies (HMAC-SHA256).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Bootstrap accounts. Only used when DATABASE_URL is not set.
# When DATABASE_URL IS set, create users with `npm run db:seed` instead.
# EJENTIC_ADMIN_EMAIL=admin@ejentic.local
# EJENTIC_ADMIN_PASSWORD=change-me
# EJENTIC_ADMIN_NAME=Administrator

# Optional second account (defaults to the VIEWER role).
# EJENTIC_USER_EMAIL=analyst@ejentic.local
# EJENTIC_USER_PASSWORD=change-me
# EJENTIC_USER_ROLE=RESEARCHER

# Used by `npm run db:seed` to create the first administrator in PostgreSQL.
# ADMIN_EMAIL=admin@ejentic.local
# ADMIN_PASSWORD=change-me
# ADMIN_NAME=Administrator

# ---- Mounting into the main Ejentic AI site -------------------------------
# The app runs standalone by default (it owns the whole domain). To serve it as
# a section of the main site instead, set BASE_PATH and rebuild.
#
#   BASE_PATH=/app  ->  https://ejenticai.com/app
#
# Next.js then prefixes every route, link and asset automatically.
#
# !! BASE_PATH and ALLOW_EMBEDDING are read at BUILD time (Next.js bakes the
# !! base path and the headers() result into the build output). Set them before
# !! `npm run build`, and rebuild after changing them - `npm start` alone will
# !! not pick up a new value.
# !!
# !! Set them HERE, not in your shell. Next.js loads this file over the top of
# !! the process environment, so leaving this line as `BASE_PATH=` overrides
# !! `BASE_PATH=/app npm run build` and you ship a build with no prefix.
BASE_PATH=
#
# Origin of the parent site. Adds a "Back to main site" link in the dashboard
# chrome, and is allow-listed for framing when ALLOW_EMBEDDING=true.
NEXT_PUBLIC_MAIN_SITE_URL=https://ejenticai.com
#
# Set true only when the app really is embedded in an iframe on the parent
# site. Swaps X-Frame-Options: DENY for a CSP frame-ancestors allow-list so
# ONLY the origin above may frame it - never a wildcard.
# BUILD TIME - rebuild after changing this.
ALLOW_EMBEDDING=false
#
# Only needed for iframe embedding over HTTPS: lets the session cookie travel
# in a cross-site frame. Requires HTTPS.
# SESSION_COOKIE_SAME_SITE=none
#
# Overrides for white-label deployments.
# NEXT_PUBLIC_PRODUCT_NAME=Ejentic AI
# NEXT_PUBLIC_COMPANY_NAME=Ejentic AI
# NEXT_PUBLIC_SUPPORT_EMAIL=hello@ejenticai.com

# ---- Web search (business discovery) --------------------------------------
# Used to find businesses from a name, niche, category or location - this is
# what lets you create a job without supplying any URLs.
#
# The app searches the open web and returns ONLY real results. If every
# provider fails it reports that honestly and queues nothing; it never
# substitutes sample data.
#
# With no keys set, it falls back to scraping DuckDuckGo and Bing. That works,
# but both rate-limit or silently degrade under load, so a real API is strongly
# recommended. Providers are tried in this order, with automatic failover:
#
#   1. Brave   - https://brave.com/search/api/   (free tier, no card)
#   2. Serper  - https://serper.dev              (free tier)
#   3. Tavily  - https://tavily.com              (free tier)
#   4. SearXNG - self-host, then unlimited and free
#   5. DuckDuckGo / Bing (scraped, last resort)
#
BRAVE_SEARCH_API_KEY=
# SERPER_API_KEY=
# TAVILY_API_KEY=
# SEARXNG_URL=https://searx.example.com
# SEARXNG_API_KEY=

# ---- Notifications / integrations -----------------------------------------
# NOT IMPLEMENTED. The contact form logs submissions only; there is no
# email provider, CRM or webhook integration in this build.
# SALESFORCE_TOKEN=
# HUBSPOT_TOKEN=
# SMTP_URL=
